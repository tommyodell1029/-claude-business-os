# Copy to .env (gitignored). NEVER commit real values.
# Server-side only unless prefixed NEXT_PUBLIC_ (none of these are public).

# --- Anthropic (runtime models are chosen in config/models.yaml)
ANTHROPIC_API_KEY=
LP_ANTHROPIC_API_KEY=    # same key; fallback name for environments that withhold ANTHROPIC_* vars

# --- Supabase (service key: server only, never in the browser)
SUPABASE_URL=            # https://arekyykkzlqgphqdegsy.supabase.co (launchpad-local project)
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice (Pipecat)
DEFAULT_CLIENT=demo      # client used when the dialed number matches no clients/*.yaml
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
PIPECAT_TOKEN=           # Pipecat Cloud CLI auth (deploy only; not a runtime secret)
PIPECAT_ORG=             # Pipecat Cloud organization ID
PIPECAT_SERVICE_HOST=    # "<agent_name>.<org>", e.g. lp-receptionist.<org> (routes Twilio streams to our agent)
TRANSFER_STREAM_URL=     # wss://us-east.api.pipecat.daily.co/ws/twilio
TRANSFER_ACTION_URL=     # public URL of the <Dial action> webhook (location: owner decision, BUILD_STATUS T4)

# --- Demo client (clients/demo.yaml reads these; keep real numbers out of git)
DEMO_TWILIO_NUMBER=
DEMO_OWNER_PHONE=
DEMO_OWNER_EMAIL=
DEMO_HANDOFF_NUMBER=

# --- Twilio (inbound numbers + owner SMS alerts; SMS needs A2P 10DLC approval)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# --- Resend (owner alert emails + site form notifications ONLY, never cold email)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
OWNER_ALERT_EMAIL=
OWNER_ALERT_PHONE=

# --- Lead gen
GOOGLE_PLACES_API_KEY=
COLD_EMAIL_PLATFORM=instantly   # instantly | smartlead
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=
DEMO_PHONE=
MAILING_ADDRESS=

# --- Site
ADMIN_REVIEW_PASSWORD=
IP_HASH_SALT=
