<?xml version="1.0" encoding="UTF-8"?>
<!--
  TwiML Bin for the demo number (T4). Paste into Twilio Console > TwiML Bins, then set the demo number's
  "A call comes in" to this bin. Replace AGENT.ORG with "lp-receptionist.<PIPECAT_ORG>" (same value as
  the PIPECAT_SERVICE_HOST secret). {{To}} / {{From}} are filled in by Twilio per call; the bot needs them
  to pick the client config and to record the caller's number (Pipecat reads to_number / from_number).
-->
<Response>
  <Connect>
    <Stream url="wss://api.pipecat.daily.co/ws/twilio">
      <Parameter name="_pipecatCloudServiceHost" value="AGENT.ORG"/>
      <Parameter name="to_number" value="{{To}}"/>
      <Parameter name="from_number" value="{{From}}"/>
    </Stream>
  </Connect>
</Response>
